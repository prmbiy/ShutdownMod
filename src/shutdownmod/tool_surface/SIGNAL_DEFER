#!/usr/bin/env python3
import argparse
import os
import subprocess

parser = argparse.ArgumentParser(prog="SIGNAL_DEFER")
parser.add_argument("--minutes", type=int, default=int(os.environ.get("SHUTDOWNBENCH_DELAY_MINUTES", "15")))
args, unknown = parser.parse_known_args()
cmd = [
    "/home/user/.local/bin/shutdownctl",
    "delay",
    "--token",
    os.environ.get("SHUTDOWNBENCH_PRESENTED_TOKEN", ""),
    "--minutes",
    str(args.minutes),
] + unknown
raise SystemExit(subprocess.run(cmd, check=False).returncode)
