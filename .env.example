# ShutdownMod environment configuration
# Copy this file to .env and fill in the values you need.
# The CLI loads it automatically (python-dotenv); no manual exporting required.

# --- OpenRouter: every model in the paper runs through it ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Optional: Anthropic / OpenAI direct (litellm reads these automatically) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Hugging Face ---
# SWE-bench Verified is committed at data/swebench, so runs work offline.
HF_HOME=.hf_cache
HF_HUB_OFFLINE=1
# Only needed for the deployment pilot, which downloads the gated jjpn2/eval_awareness
# dataset (accept its terms on the Hub first). The pilot re-enables network access itself.
HF_TOKEN=
